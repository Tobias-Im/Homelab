# Run the keep-alive script every 1 minute, stoping HDD to spin down

* * * * * Saturday /home/Saturday/wall/Scripts/StopHddSpinDown/keep_alive_share.sh >/dev/null 2>&1

# Watchtower uses Docker API to update individual containers ; Docker Compose manages a group of services (project) based on the static docker-compose.yml file.
# Running docker compose up -d forces Compose to reconcile its internal state with the running containers. It re-adopts the new container IDs and verifies all settings (especially networks) based on the YAML file.

10 7 15 * * Saturday /usr/bin/docker compose -f /home/Saturday/wall/Docker/docker-compose.yml up -d

# Run full homelab backup only Sunday at 3:00 AM
0 3 * * 0 Saturday /home/Saturday/wall/Scripts/BackUp/homelab_backup.sh >/dev/null 2>&1

# Clean up local backups (retain only the last one) on Sunday at 4:00 AM
0 4 * * 0 Saturday /home/Saturday/wall/Scripts/BackUp/homelab_cleanup_backups.sh >/dev/null 2>&1

# Upload the latest backup to Google Drive and retain only the last one on Sunday at 5:00 AM
0 5 * * 0 Saturday /home/Saturday/wall/Scripts/BackUp/homelab_cloud_upload.sh >/dev/null 2>&1
